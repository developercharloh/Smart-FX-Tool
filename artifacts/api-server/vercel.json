{
  "version": 2,
  "installCommand": "cd ../../ && pnpm install --frozen-lockfile",
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "crons": [
    { "path": "/api/scanner/trigger", "schedule": "*/2 * * * *" }
  ],
  "functions": {
    "api/index.ts": { "maxDuration": 60, "memory": 512 }
  }
}
